# BarrierLens Environment Configuration Template
# Copy this file to .env.local for local development.

# --- Database & Realtime (Supabase Postgres & pgvector) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
SUPABASE_SECRET_KEY=sb_secret_<key>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Connect to Postgres via shared transaction-mode pooler (IPv4)
DATABASE_URL=postgresql://postgres.<project-ref>:[PASSWORD]@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Connect to Postgres via session-mode pooler (for migrations)
DIRECT_URL=postgresql://postgres.<project-ref>:[PASSWORD]@<region>.pooler.supabase.com:5432/postgres

# --- Authentication (BetterAuth + Passkey WebAuthn) ---
BETTER_AUTH_SECRET=generate-a-64-character-random-hex-string
BETTER_AUTH_URL=http://localhost:3000
AUTH_RP_ID=localhost

# --- AI & LLM Model Inference Tiers ---
# Tier 1: Local Python FastAPI backend (http://127.0.0.1:8000)
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# Tier 2: Groq LLaMA 3.3 Fast Inference
GROQ_API_KEY=gsk_your_groq_api_key_here

# Tier 3: Google Gemini Flash Multimodal Grounding
GEMINI_API_KEY=your_gemini_api_key_here

# --- AWS Cloud Infrastructure (Bedrock & S3 Artifact Vault) ---
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=barrierlens-audit-artifacts-us-east-1

# --- Autonomous GitHub Bot (Pull Requests & Check Annotations) ---
GITHUB_TOKEN=ghp_your_github_personal_access_token_or_app_installation_token

# --- Headless Browser Execution (Cloud CDP Provider) ---
# Optional: Set to connect to a remote browser (Browserless.io, Browserbase, or private Chrome container)
# If unset, uses local headless Chromium with container-hardened flags.
BROWSER_WS_ENDPOINT=wss://chrome.browserless.io?token=your_browserless_token

# --- Background Worker Execution Queue ---
WORKER_SECRET=optional_secret_token_to_secure_worker_tick_endpoint
