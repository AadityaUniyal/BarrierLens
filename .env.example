# BarrierLens Environment Configuration Template
# Copy this file to .env.local for local development.

# --- Database (Neon Serverless Postgres) ---
DATABASE_URL=postgresql://user:password@ep-placeholder.region.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=postgresql://user:password@ep-placeholder.region.aws.neon.tech/neondb?sslmode=require
NEON_DATA_API_URL=https://ep-placeholder.apirest.region.aws.neon.tech/neondb/rest/v1
NEON_REALTIME_URL=https://ep-placeholder.rt.region.aws.neon.tech/
NEON_PROJECT_ID=your-project-id
NEON_ORG_ID=your-org-id
NEON_BRANCH=production

# --- Authentication (BetterAuth + Passkey WebAuthn) ---
BETTER_AUTH_SECRET=generate-a-64-character-random-hex-string
BETTER_AUTH_URL=http://localhost:3000
AUTH_RP_ID=localhost

# --- AI & LLM Model Inference Tiers ---
# Tier 1: Local Python FastAPI backend (http://127.0.0.1:8000)
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# Tier 2: Groq LLaMA 3.3 Fast Inference
GROQ_API_KEY=gsk_your_groq_api_key_here

# Tier 3: Google Gemini Flash Multimodal Grounding
GEMINI_API_KEY=your_gemini_api_key_here

# --- AWS Cloud Infrastructure (Bedrock & S3 Artifact Vault) ---
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=barrierlens-audit-artifacts-us-east-1

# --- Autonomous GitHub Bot (Pull Requests & Check Annotations) ---
GITHUB_TOKEN=ghp_your_github_personal_access_token_or_app_installation_token

# --- Background Worker Execution Queue ---
WORKER_SECRET=optional_secret_token_to_secure_worker_tick_endpoint
